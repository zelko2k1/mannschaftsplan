# Vorlage — nach .env kopieren und ausfüllen. .env ist gitignored.
# Gebraucht wird das nur von pocketbase/seed.mjs; die App selbst liest keine dieser Variablen.

# PocketBase-Superuser. Anlegen mit:
#   cd pocketbase && ./pocketbase superuser upsert <mail> <passwort> --dir=pb_data
# Die Adresse muss eine gültige Form haben — „dev@localhost" lehnt PocketBase ab.
PB_SUPERUSER_EMAIL=dev@example.com
PB_SUPERUSER_PASSWORD=

# Nur setzen, wenn PocketBase woanders läuft als lokal auf 8090.
#PB_URL=http://127.0.0.1:8090
