# Vorlage — nach .env kopieren und ausfüllen. .env ist gitignored.
#
# Zwei Teile: unten die Skripte (Seed gibt es keinen mehr, aber Tests und Backup melden sich als
# Superuser an), oben der Betrieb mit dem Caddy-Overlay. Die App selbst liest nichts davon.
# Wer nur docker-compose.yaml hinter einem eigenen Proxy fährt, braucht diese Datei nicht.

# ─── Betrieb mit docker-compose.caddy.yaml ──────────────────────────────────────────────────
# Nur nötig, wenn Caddy aus diesem Stack kommen soll. Fehlt einer der vier, fährt der Stack
# nicht an — mit einer Meldung, die sagt, welcher.

# Der Name, unter dem die App erreichbar ist. Ein A-Record darauf muss auf diesen Server zeigen,
# sonst bekommt Caddy kein Zertifikat.
DOMAIN=

# Adresse für die Benachrichtigungen von Let's Encrypt.
ACME_EMAIL=

# R13b · Das Tor vor /admin — eine eigene Anmeldung im Proxy, unabhängig vom Kapitäns-Passwort.
# Ohne sie stünde die Kapitänsansicht mit nur einem Passwort im Internet. Benutzername frei
# wählbar, den Hash erzeugst du dir selbst:
#   docker run --rm caddy:2.11.4-alpine caddy hash-password --plaintext '<dein-passwort>'
ADMIN_USER=
ADMIN_PASSWORD_HASH=

# Optional und nur zusätzlich: fester Adressbereich oder VPN, aus dem /admin erreichbar sein
# soll. Wirkt erst, wenn in deploy/Caddyfile die beiden @fremd-Zeilen eingeschaltet sind.
#ADMIN_ALLOW=10.8.0.0/24

# ─── Skripte ────────────────────────────────────────────────────────────────────────────────

# Der Superuser, den du selbst angelegt hast — beim ersten Start über den Einrichtungslink, den
# PocketBase auf der Konsole ausgibt, oder von Hand mit:
#   cd pocketbase && ./pocketbase superuser upsert <deine-adresse> <dein-passwort> --dir=pb_data
# Hier stehen bewusst keine Vorgaben: trag deinen eigenen Zugang ein.
# Die Adresse muss eine gültige Form haben — „dev@localhost" lehnt PocketBase ab.
PB_SUPERUSER_EMAIL=
PB_SUPERUSER_PASSWORD=

# Nur setzen, wenn PocketBase woanders läuft als lokal auf 8090.
#PB_URL=http://127.0.0.1:8090
