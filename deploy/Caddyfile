# Caddy für den öffentlichen Betrieb: eigene Domain, Zertifikat automatisch über Let's Encrypt.
#
# Diese Datei wird NICHT editiert. Alles, was sich von Betrieb zu Betrieb unterscheidet, kommt aus
# der Umgebung und damit aus der `.env` neben `docker-compose.yaml`:
#
#   DOMAIN                 dart.deinedomain.de
#   ACME_EMAIL             Adresse für die Zertifikats-Benachrichtigungen
#   ADMIN_USER             Benutzername für das Gate vor /admin (R13b)
#   ADMIN_PASSWORD_HASH    dessen bcrypt-Hash
#   ADMIN_ALLOW            optional: aus welchen Netzen /admin überhaupt erreichbar ist
#   MANAGE_ALLOW           optional: aus welchen Netzen /manage überhaupt erreichbar ist
#
# Die beiden ALLOW-Werte sind ohne Eintrag offen (`0.0.0.0/0 ::/0`) — es ändert sich also nichts,
# solange sie niemand setzt. Die README erklärt unter „Nur aus dem eigenen Netz erreichbar
# machen", wann sich das lohnt und wie man sich dabei nicht selbst aussperrt.
#
# Wer Caddy selbst betreibt statt über docker-compose.caddy.yaml, setzt dieselben Variablen in der
# Umgebung des Caddy-Prozesses — oder trägt die Werte hier direkt ein.
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	# R9 · Kopfzeilen. frame-ancestors 'none' und base-uri 'none' stehen bewusst in der CSP,
	# style-src 'unsafe-inline' ist nötig, weil React Styles inline setzt.
	#
	# DIESE LISTE MUSS MIT pb_hooks/kopfzeilen.pb.js ÜBEREINSTIMMEN — bis auf HSTS, das
	# ausschließlich hier steht. Setzt Caddy eine Kopfzeile, die die App auch setzt, gewinnt
	# Caddy: Eine Abweichung ist deshalb keine doppelte Absicherung, sondern eine
	# Verschlechterung, die im Betrieb gilt und beim Ausprobieren ohne Proxy nicht auffällt.
	header {
		X-Robots-Tag "noindex, nofollow"
		Referrer-Policy "no-referrer"
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		-Server
	}

	# ── R13a · Das PocketBase-Dashboard ist NIE öffentlich erreichbar ───────────────────────────
	# Keine Allowlist, kein Schalter, keine Ausnahme: es sieht die ganze Datenbank und wird im
	# Betrieb nie gebraucht. Wer hinein muss (Einrichten, Restore, Notfall), tunnelt — in
	# docker-compose.yaml den an 127.0.0.1 gebundenen Port aktivieren, dann
	#     ssh -L 8090:127.0.0.1:8090 <server>
	# und im Browser http://127.0.0.1:8090/_/ öffnen.
	# Antwort ist 404, nicht 403 — kein Hinweis darauf, dass es hier etwas gibt (R6).
	@dashboard path /_/*
	handle @dashboard {
		respond 404
	}

	# ── R13e · Der Weg für den Kapitän steht offen ──────────────────────────────────────────────
	# Hier arbeiten die Kapitäne: Spieltage, Spieler, Rückmeldungen — jeder nur in seiner eigenen
	# Mannschaft. Kein Gate davor, und das ist eine Entscheidung, keine Lücke: Ein geteiltes
	# Proxy-Passwort für acht Leute ist nicht widerrufbar, kennt kein Abmelden und landet im
	# Zweifel im Mannschafts-Chat. Was an seiner Stelle steht, ist in R13e des Umsetzungsplans
	# aufgeschrieben — erzeugte Passwörter, Sperre pro Konto, enge Rechte.
	#
	# MANAGE_ALLOW schränkt ein, WOHER das erreichbar ist. Ohne Eintrag: von überall.
	@manage path /manage*
	handle @manage {
		@manage_fremd not remote_ip {$MANAGE_ALLOW:0.0.0.0/0 ::/0}
		respond @manage_fremd 404
		reverse_proxy mannschaftsplan:8090
	}

	# ── R13b · Vor dem Admin-Gebiet steht ein Gate ──────────────────────────────────────────────
	# Alles unter /admin darf nur die Rolle `admin`: Konten und Rollen, Mannschaften anlegen und
	# löschen, Einstellungen, Sicherungen. Da hängt der Zugriff auf ALLE Mannschaften und auf die
	# Datenbankdatei — ein Fehler in diesem Code soll von außen gar nicht erst ansprechbar sein.
	# Das Gate ist eine eigene Anmeldung im Proxy, unabhängig von der in der App, und funktioniert
	# aus jedem Netz — auch vom Handy im Mobilnetz.
	#
	# Der Hash gehört dir, nicht dieser Datei. Erzeugen mit:
	#     docker run --rm caddy:2.11.4-alpine caddy hash-password --plaintext '<dein-passwort>'
	#
	# Wer zusätzlich eine feste Adresse oder ein VPN hat, trägt sie in ADMIN_ALLOW ein — dann muss
	# beides stimmen, Netz UND Passwort.
	@admin path /admin*
	handle @admin {
		@admin_fremd not remote_ip {$ADMIN_ALLOW:0.0.0.0/0 ::/0}
		respond @admin_fremd 404
		basic_auth {
			{$ADMIN_USER} {$ADMIN_PASSWORD_HASH}
		}
		reverse_proxy mannschaftsplan:8090
	}

	# ── R13c · Die Superuser-Anmeldung liegt hinter demselben Gate ──────────────────────────────
	# Ohne diesen Block schützt der zweite Faktor aus Abschnitt 9 nur die Kapitänsansicht: Wer
	# Adresse und Passwort des Superusers kennt, holt sich über
	#     POST /api/collections/_superusers/auth-with-password
	# einen Token und kommt damit an die gesamte Datenbank, ohne /admin je zu berühren — und
	# könnte dort auch gleich den zweiten Faktor löschen.
	#
	# Der Token ist der Angelpunkt: Auf keiner Collection stehen Regeln, ohne ihn ist die API
	# also verschlossen. Wird sein einziger Ausgabeschalter mit demselben Gate gesichert wie
	# /admin, ist die Lücke zu.
	#
	# Der ganze Präfix, nicht nur `auth-with-password`: `auth-refresh`, `auth-with-otp`,
	# `request-password-reset` und `impersonate` führten sonst am Gate vorbei zum selben Ziel.
	#
	# Was das für Skripte bedeutet: Wer von außen als Superuser spricht — `scripts/backup.sh`
	# etwa —, braucht zusätzlich `curl -u <ADMIN_USER>:<passwort>`. Wer durch einen SSH-Tunnel
	# direkt auf 8090 geht, ist nicht betroffen; dort steht kein Caddy.
	@superuser path /api/collections/_superusers/*
	handle @superuser {
		basic_auth {
			{$ADMIN_USER} {$ADMIN_PASSWORD_HASH}
		}
		reverse_proxy mannschaftsplan:8090
	}

	# R8 · Einladungslinks gar nicht protokollieren. Das Token steht im PFAD; der Query-Filter
	# weiter unten würde es unverändert im Log stehen lassen (Testfall T10).
	@join path /j/*
	handle @join {
		log_skip
		reverse_proxy mannschaftsplan:8090
	}

	handle {
		reverse_proxy mannschaftsplan:8090
	}

	log {
		output file /var/log/caddy/mannschaftsplan.log
		format filter {
			request>uri query {
				delete *
			}
		}
	}
}

# ── Eigene Dienste desselben Servers ────────────────────────────────────────────────────────
# Wer neben dem Mannschaftsplan noch etwas betreibt, legt dessen Site-Block als eigene Datei in
# `deploy/conf.d/` ab — er wird hier eingelesen. Diese Vorlage bleibt dabei unangetastet, und
# damit auch die Regeln aus R13, die in ihr stehen.
#
# Der Weg über ein Verzeichnis statt über eine Änderung an dieser Datei ist Absicht: Was der
# Betreiber hier hineinschreibt, gehört ihm und liegt in `.gitignore`. Ein `git pull` bricht
# sonst mit einem Konflikt ab, und zwar an der Datei, die das Gate vor `/admin` trägt.
#
# Der Pfad ist RELATIV zu dieser Datei — im Container wird daraus `/etc/caddy/conf.d`, in der CI
# das Verzeichnis neben der Vorlage. Beide Male dieselbe Zeile, ohne Sonderfall.
import conf.d/*.caddy
